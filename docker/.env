# General settings
HD_BASE_URL="https://hedgedoc2.localhost"
# Must be at least 32 characters long
HD_AUTH_SESSION_SECRET="change_me_in_production_0123456789"
# The default, 127.0.0.1, is unreachable from the proxy container
HD_BACKEND_BIND_IP="0.0.0.0"

# Database settings
HD_DATABASE_TYPE="postgres"
HD_DATABASE_HOST="db"
HD_DATABASE_PORT="5432"
HD_DATABASE_NAME="hedgedoc"
HD_DATABASE_USERNAME="hedgedoc"
HD_DATABASE_PASSWORD="password"

# Uploads
HD_MEDIA_BACKEND_TYPE="filesystem"
HD_MEDIA_BACKEND_FILESYSTEM_UPLOAD_PATH="uploads/"

# Auth
HD_AUTH_LOCAL_ENABLE_LOGIN="true"
HD_AUTH_LOCAL_ENABLE_REGISTER="true"

# Note permissions
# These three must be set together: the defaults are 'full' for the maximum
# guest level and 'read' for everyone, a combination the configuration
# validator rejects, so the backend refuses to start when they are left out.
HD_NOTE_PERMISSIONS_MAX_GUEST_LEVEL="write"
HD_NOTE_PERMISSIONS_DEFAULT_EVERYONE="read"
HD_NOTE_PERMISSIONS_DEFAULT_LOGGED_IN="write"
