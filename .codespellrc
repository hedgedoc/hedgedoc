[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
skip = .git,.git-meta,.gitignore,.gitattributes,.*cache,.turbo,.next,node_modules,dist,*.svg,*-lock.yaml,*.css,.codespellrc,.mailmap,AUTHORS
check-hidden = true
# ignore-regex =
ignore-words-list =
  # jest's afterAll() hook (matching is case-insensitive)
  afterall
